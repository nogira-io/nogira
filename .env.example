# Copy to .env and set strong values before: docker compose up -d
POSTGRES_PASSWORD=change-me
# Session signing secret. Leave empty and NoGira generates and stores one on first start.
# If you set it, use 32+ random characters (e.g. `openssl rand -base64 48`); sample values are refused in production.
JWT_SECRET=
# Alphanumeric only. Core sets the nogira_worker database login from this value.
NOGIRA_WORKER_DB_PASSWORD=changeme
